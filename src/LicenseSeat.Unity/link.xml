<?xml version="1.0" encoding="utf-8"?>
<!-- Runtime preservation rules. Validate these with real Mono and IL2CPP builds. -->
<linker>
  <!-- Core and Unity-facing SDK types include reflection-based JSON models. -->
  <assembly fullname="LicenseSeat.Unity.Runtime" preserve="all"/>

  <!-- System.Text.Json uses reflection metadata for SDK model serialization. -->
  <assembly fullname="System.Text.Json" preserve="all"/>
  <assembly fullname="System.Text.Encodings.Web" preserve="all"/>

  <!-- Ed25519 verification instantiates these managed crypto types at runtime. -->
  <assembly fullname="BouncyCastle.Cryptography" preserve="all"/>
</linker>
