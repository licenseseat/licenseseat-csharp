# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.cs]
# Prefer concise namespaces outside the Unity-shared source set.
csharp_style_namespace_declarations = file_scoped:warning

[src/LicenseSeat/**/*.cs]
# These files are copied into Unity 2021/2022, whose compiler supports C# 9.
csharp_style_namespace_declarations = block_scoped:warning

[src/LicenseSeat/*.cs]
csharp_style_namespace_declarations = block_scoped:warning

[src/LicenseSeat.Unity/Runtime/Core/**/*.cs]
csharp_style_namespace_declarations = block_scoped:warning

[src/LicenseSeat.Unity/Runtime/Core/*.cs]
csharp_style_namespace_declarations = block_scoped:warning

# Prefer 'var' when type is apparent
csharp_style_var_when_type_is_apparent = true:suggestion

# Allow underscores in test method names
[*Tests.cs]
dotnet_diagnostic.CA1707.severity = none
